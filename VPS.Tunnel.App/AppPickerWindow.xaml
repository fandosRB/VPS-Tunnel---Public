<Window x:Class="VPS.Tunnel.App.AppPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Выбор программ" Width="460" Height="580" MinWidth="380" MinHeight="420"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="{StaticResource AppFont}" FontSize="13" UseLayoutRounding="True">
 <Grid Margin="18">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,10">
   <TextBlock x:Name="HeaderText" Text="Установленные программы" Style="{StaticResource SectionTitle}"/>
   <TextBlock Text="Отметьте программы, которые должны работать через VPS." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </StackPanel>
  <Grid Grid.Row="1" Margin="0,0,0,10">
   <TextBox x:Name="SearchBox" Height="32" Padding="28,0,6,0" VerticalContentAlignment="Center"
    Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
    CaretBrush="{DynamicResource TextBrush}" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Поиск"/>
   <Path Data="M10,3 A7,7 0 1 0 10,17 A7,7 0 1 0 10,3 M15,15 L21,21" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.6"
    Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False"/>
   <TextBlock x:Name="SearchHint" Text="Поиск" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" Margin="30,0,0,0" IsHitTestVisible="False"/>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="4">
   <Grid>
    <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
     VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="Список программ">
     <ListBox.ItemContainerStyle>
      <Style TargetType="ListBoxItem">
       <Setter Property="Padding" Value="0"/>
       <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="Row" Background="Transparent" CornerRadius="6"><ContentPresenter/></Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></Setter.Value></Setter>
      </Style>
     </ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate>
      <DataTemplate>
       <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="6,4" VerticalContentAlignment="Center" Foreground="{DynamicResource TextBrush}">
        <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
         <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
         <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="{Binding ExecutableName}" Style="{StaticResource SecondaryTextStyle}" FontSize="11"/>
         </StackPanel>
        </StackPanel>
       </CheckBox>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="StatusText" Text="Загрузка списка…" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="20" IsHitTestVisible="False"/>
   </Grid>
  </Border>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Style="{StaticResource TextButtonStyle}" IsCancel="True"><TextBlock Text="Отмена" Margin="16,0"/></Button>
   <Button Style="{StaticResource TextButtonStyle}" Margin="8,0,0,0" Click="Add_Click" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}"><TextBlock Text="Добавить отмеченные" Margin="16,0" Foreground="{DynamicResource WhiteBrush}"/></Button>
  </StackPanel>
 </Grid>
</Window>
