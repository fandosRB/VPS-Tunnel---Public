<Window x:Class="VPS.Tunnel.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="VPS Tunnel" Width="560" Height="752" MinWidth="480" MinHeight="668"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
 FontFamily="{StaticResource AppFont}" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="60" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Border x:Name="WindowFrame" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <!-- Native WPF caption hit testing covers the entire transparent header. -->
   <Grid x:Name="TitleBar" Background="Transparent" Margin="18,0,8,0">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
     <Border Background="{DynamicResource AccentSoftBrush}" Width="32" Height="32" CornerRadius="10">
      <Path Style="{StaticResource VectorIcon}" Data="{StaticResource ShieldIcon}" Stroke="{DynamicResource AccentBrush}"/>
     </Border>
     <TextBlock Text="VPS Tunnel" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>
    <!-- Interactive caption elements are explicitly excluded from window dragging. -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="2" Margin="0,0,8,0">
      <StackPanel Orientation="Horizontal">
       <Button x:Name="LightThemeButton" Style="{StaticResource IconButtonStyle}" Click="LightTheme_Click" ToolTip="Светлая тема" AutomationProperties.Name="Светлая тема">
        <Path Style="{StaticResource VectorIcon}" Data="{StaticResource SunIcon}" Width="17" Height="17"/>
       </Button>
       <Button x:Name="SystemThemeButton" Style="{StaticResource IconButtonStyle}" Click="SystemTheme_Click" ToolTip="Как в Windows" AutomationProperties.Name="Системная тема" Width="42">
        <TextBlock Text="Авто" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
       </Button>
       <Button x:Name="DarkThemeButton" Style="{StaticResource IconButtonStyle}" Click="DarkTheme_Click" ToolTip="Тёмная тема" AutomationProperties.Name="Тёмная тема">
        <Path Style="{StaticResource VectorIcon}" Data="{StaticResource MoonIcon}" Width="17" Height="17"/>
       </Button>
      </StackPanel>
     </Border>
     <Button x:Name="MinimizeButton" Style="{StaticResource IconButtonStyle}" Width="38" Click="Minimize_Click" ToolTip="Свернуть" AutomationProperties.Name="Свернуть">
      <Path Data="{StaticResource MinimizeIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="14" Height="12"/>
     </Button>
     <Button x:Name="CloseButton" Style="{StaticResource IconButtonStyle}" Width="38" Click="Close_Click" ToolTip="Закрыть" AutomationProperties.Name="Закрыть">
      <Path Data="{StaticResource CloseIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="16" Height="16"/>
     </Button>
    </StackPanel>
   </Grid>
   <!-- WPF uses DIPs at all monitor DPIs. At minimum size the complete layout scales down together. -->
   <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" Margin="20,0,20,16">
    <Grid x:Name="MainContent" Width="512" Height="658">
     <Grid.RowDefinitions>
      <RowDefinition Height="190"/><RowDefinition Height="80"/><RowDefinition Height="10"/>
      <RowDefinition Height="106"/><RowDefinition Height="10"/><RowDefinition Height="88"/>
      <RowDefinition Height="10"/><RowDefinition Height="164"/>
     </Grid.RowDefinitions>
     <Grid x:Name="StatusBlock" Width="180" Height="180" VerticalAlignment="Top">
      <Ellipse x:Name="StatusRing" Stroke="{DynamicResource NeutralBrush}" StrokeThickness="3" Fill="{DynamicResource WindowBrush}"/>
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
       <Path x:Name="StatusIcon" Style="{StaticResource VectorIcon}" Data="{StaticResource GlobeIcon}" Stroke="{DynamicResource NeutralBrush}" Width="36" Height="36" StrokeThickness="1.4"/>
       <TextBlock x:Name="StatusTitle" Text="DIRECT" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,3"/>
       <TextBlock x:Name="StatusSubtitle" Text="Прямое соединение" FontSize="11.5" Width="166" TextAlignment="Center" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Center"/>
      </StackPanel>
     </Grid>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Button x:Name="DirectButton" Style="{StaticResource ModeCardStyle}" Click="Direct_Click" AutomationProperties.Name="DIRECT">
       <StackPanel><Path Style="{StaticResource VectorIcon}" Data="{StaticResource GlobeIcon}" Width="22" Height="22"/><TextBlock Text="DIRECT" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,1" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock Text="Обычное" Style="{StaticResource SecondaryTextStyle}" FontSize="11" HorizontalAlignment="Center"/></StackPanel>
      </Button>
      <Button x:Name="SelectiveButton" Grid.Column="2" Style="{StaticResource ModeCardStyle}" Click="Selective_Click" AutomationProperties.Name="SELECTIVE" ToolTip="Через VPS — только выбранные программы">
       <StackPanel><Path Style="{StaticResource VectorIcon}" Data="{StaticResource AppsIcon}" Width="22" Height="22"/><TextBlock Text="SELECTIVE" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,1" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock x:Name="SelectiveHint" Text="Выбранные" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}"/></StackPanel>
      </Button>
      <Button x:Name="TunnelButton" Grid.Column="4" Style="{StaticResource ModeCardStyle}" Click="Tunnel_Click" AutomationProperties.Name="TUNNEL">
       <StackPanel><Path Style="{StaticResource VectorIcon}" Data="{StaticResource ShieldIcon}" Width="22" Height="22"/><TextBlock Text="TUNNEL" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,3,0,1" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><TextBlock x:Name="TunnelHint" Text="Через VPS" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}"/></StackPanel>
      </Button>
     </Grid>
     <Border Grid.Row="3" Style="{StaticResource CardStyle}">
      <StackPanel>
       <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Style="{StaticResource VectorIcon}" Data="{StaticResource LocationIcon}" Stroke="{DynamicResource AccentBrush}" Width="17" Height="17" Margin="0,0,8,0"/><TextBlock Text="Подключение" Style="{StaticResource SectionTitle}"/></StackPanel>
        <Button x:Name="ConnectionSettingsButton" Grid.Column="1" Click="ConnectionSettings_Click" Style="{StaticResource IconButtonStyle}" Width="84" Height="22" FontSize="11" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="Настройки подключения"><TextBlock Text="Изменить" Foreground="{DynamicResource AccentBrush}"/></Button>
       </Grid>
       <UniformGrid Columns="4">
        <StackPanel><TextBlock Text="IP" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="IpValue" Text="Проверка..." Margin="0,4,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="Страна" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="CountryValue" Text="—" Margin="0,4,0,0"/></StackPanel>
        <StackPanel><TextBlock Text="Сервер" Style="{StaticResource SecondaryTextStyle}"/><TextBlock x:Name="ServerValue" Text="—" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
        <StackPanel><TextBlock Text="Протокол" Style="{StaticResource SecondaryTextStyle}"/><TextBlock Text="VLESS + Reality" Margin="0,4,0,0"/></StackPanel>
       </UniformGrid>
      </StackPanel>
     </Border>
     <Border Grid.Row="5" Style="{StaticResource CardStyle}">
      <Grid><Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition/></Grid.RowDefinitions>
       <TextBlock Text="Текущая сессия" Style="{StaticResource SectionTitle}"/>
       <UniformGrid Grid.Row="1" Columns="3">
        <StackPanel><StackPanel Orientation="Horizontal"><Path Style="{StaticResource VectorIcon}" Data="{StaticResource ClockIcon}" Stroke="{DynamicResource SecondaryBrush}" Width="15" Height="15" Margin="0,0,7,0"/><TextBlock x:Name="ElapsedValue" Text="00:00:00" FontSize="15" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Время" Style="{StaticResource SecondaryTextStyle}" Margin="22,2,0,0"/></StackPanel>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="18,0,0,0"><StackPanel><StackPanel Orientation="Horizontal"><Path Style="{StaticResource VectorIcon}" Data="{StaticResource DownloadIcon}" Stroke="{DynamicResource AccentBrush}" Width="15" Height="15" Margin="0,0,7,0"/><TextBlock x:Name="DownloadValue" Text="—" FontSize="15" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Получено" Style="{StaticResource SecondaryTextStyle}" Margin="22,2,0,0"/></StackPanel></Border>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="18,0,0,0"><StackPanel><StackPanel Orientation="Horizontal"><Path Style="{StaticResource VectorIcon}" Data="{StaticResource UploadIcon}" Stroke="{DynamicResource SecondaryBrush}" Width="15" Height="15" Margin="0,0,7,0"/><TextBlock x:Name="UploadValue" Text="—" FontSize="15" FontWeight="SemiBold"/></StackPanel><TextBlock Text="Отправлено" Style="{StaticResource SecondaryTextStyle}" Margin="22,2,0,0"/></StackPanel></Border>
       </UniformGrid>
      </Grid>
     </Border>
     <Border Grid.Row="7" Style="{StaticResource CardStyle}">
      <StackPanel>
       <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource VectorIcon}" Data="{StaticResource SettingsIcon}" Stroke="{DynamicResource SecondaryBrush}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Настройки" Style="{StaticResource SectionTitle}"/></StackPanel>
        <Button x:Name="SetupButton" Grid.Column="1" Content="Настроить" Click="Setup_Click" Visibility="Collapsed" Style="{StaticResource IconButtonStyle}" Width="84" Height="22" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
       </Grid>
       <CheckBox x:Name="WindowsStartupCheck" Content="Запускать с Windows" Style="{StaticResource FluentToggleStyle}"/>
       <CheckBox x:Name="MinimizedCheck" Content="Запускать свёрнутым" Style="{StaticResource FluentToggleStyle}"/>
       <Grid Height="28"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions><TextBlock Text="Стартовый режим" VerticalAlignment="Center"/>
        <ComboBox x:Name="StartupComboBox" Grid.Column="1" Style="{StaticResource FluentComboBoxStyle}" AutomationProperties.Name="Стартовый режим"><ComboBoxItem Content="DIRECT"/><ComboBoxItem Content="Последний"/><ComboBoxItem Content="TUNNEL"/><ComboBoxItem Content="SELECTIVE"/></ComboBox>
       </Grid>
       <Grid Height="32"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="155"/></Grid.ColumnDefinitions><TextBlock Text="Программы SELECTIVE" VerticalAlignment="Center"/>
        <Button x:Name="SelectiveAppsButton" Grid.Column="1" Click="SelectiveApps_Click" Style="{StaticResource IconButtonStyle}" Width="155" Height="28" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Изменить программы SELECTIVE"><TextBlock x:Name="SelectiveAppsText" Text="Изменить"/></Button>
       </Grid>
      </StackPanel>
     </Border>
    </Grid>
   </Viewbox>
  </Grid>
 </Border>
</Window>
